# Firebase web configuration — these are PUBLIC client-side values.
# They identify your Firebase project and are safe to include in browser code.
# They are NOT service-account credentials. Do not put private keys here.
#
# Get these from Firebase Console → Project Settings → General → Your apps → Web app.
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Optional: Backend base URL (defaults to /api via Vite dev proxy).
# Set this in production if the frontend and backend are on different origins.
# VITE_API_BASE_URL=https://your-backend.example.com
