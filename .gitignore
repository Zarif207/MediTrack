# ── Secrets ───────────────────────────────────────────────────────────────────
# Real environment files. Only the placeholder templates are committed.
.env
.env.*
*.env
!.env.example
!*.env.example

# Firebase service accounts, Google credentials, keys and certificates
*firebase-adminsdk*.json
serviceAccount*.json
service-account*.json
*service_account*.json
*credentials*.json
application_default_credentials.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
id_rsa*
id_ed25519*

# Firebase CLI local state and emulator exports
.firebase/
.firebaserc.local
firebase-debug*.log
firestore-debug.log
ui-debug.log
emulator-data/

# Stripe CLI local config
.stripe/

# Vercel CLI link and pulled environment variables (contain secrets)
.vercel/

# ── Data ──────────────────────────────────────────────────────────────────────
# Database dumps, backups and local databases (may contain patient data)
*.sql
*.sql.gz
*.dump
*.backup
*.bak
*.db
*.sqlite
*.sqlite3
backups/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
coverage/
.vite/
.eslintcache

# ── Logs and screenshots ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
e2e/shots/

# ── OS and editors ────────────────────────────────────────────────────────────
