# ── Runtime ───────────────────────────────────────────────────────────────────
# development | test | production. "production" enforces strict settings at
# startup (explicit CORS origins, SQL echo off, Firebase must initialise) and
# hides the interactive API docs.
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Replace with your PostgreSQL connection string. Never commit real passwords.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/meditrack_db

# Optional: database used by the test suite. Defaults to DATABASE_URL with
# "_test" appended to the database name (meditrack_db_test). The suite drops
# and recreates every table in it, so never point it at real data.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/meditrack_db_test

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Absolute path to the service-account JSON downloaded from
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Keep this file outside the repository.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/meditrack-firebase-adminsdk.json
FIREBASE_PROJECT_ID=meditrack-7fe46

# ── Allowed CORS origins ─────────────────────────────────────────────────────
# Comma-separated list. Include your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Stripe Checkout (optional; TEST MODE ONLY) ───────────────────────────────
# Leave unset to disable online payment. Keys come from Stripe Dashboard →
# Developers → API keys with "Test mode" on. Live keys (sk_live_…) are refused.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret: from `stripe listen` locally, or the endpoint's
# "Signing secret" in Dashboard → Developers → Webhooks.
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd                      # must match VITE_CURRENCY in the frontend
# PUBLIC_APP_URL=http://localhost:5173     # where Stripe returns the browser

# ── SQLAlchemy logging ────────────────────────────────────────────────────────
# Logs SQL with parameters (which can include patient data). Keep false unless
# debugging locally; it must be false in production.
DB_ECHO=false
